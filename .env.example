APP_NAME=AIA
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=prod
LOG_LEVEL=INFO

LLM_BACKEND=none
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b-instruct
LLM_TIMEOUT_SECONDS=3.0
LLM_API_KEY=
LLM_PROVIDER=generic

STATE_STORE_MODE=redis
REDIS_URL=redis://localhost:6379/0
DB_BRIDGE_BACKEND=sqlite
DB_BRIDGE_SQLITE_PATH=./aia_bridge.db
DB_BRIDGE_POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/aia
DB_BRIDGE_MYSQL_DSN=mysql+pymysql://root:root@localhost:3306/aia

DEFAULT_RETREAT_HP_THRESHOLD=30
DEFAULT_HEAL_HP_THRESHOLD=50
ADAPTIVE_PREFERRED_BONUS=0.05
ADAPTIVE_AVOID_PENALTY=0.15
LEARNING_REWARD_DECAY=0.98

ENABLE_API_KEY_AUTH=true
API_KEY=change-me
ALLOW_BATCH_REQUESTS=true
MAX_BATCH_SIZE=50
ENABLE_WEBSOCKET_GATEWAY=true
