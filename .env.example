APP_NAME=AIA
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENV=local
LOG_LEVEL=INFO

LLM_BACKEND=none
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b-instruct
LLM_TIMEOUT_SECONDS=3.0
LLM_API_KEY=
LLM_PROVIDER=generic
LLM_MAX_PARALLEL_REQUESTS=8
LLM_DISABLE_FOR_BULK_SCALE=true
AGENT_FRAMEWORK_PROVIDER=native
AGENT_FRAMEWORK_ENABLED=false
AGENT_FRAMEWORK_BASE_URL=
AGENT_FRAMEWORK_TIMEOUT_SECONDS=5.0

# Default server-integration mode.
# Use memory first; switch to redis only after Redis is installed and reachable.
STATE_STORE_MODE=memory
REDIS_URL=redis://localhost:6379/0

# MySQL 5.5 game-server integration example.
DB_BRIDGE_BACKEND=mysql
DB_BRIDGE_SQLITE_PATH=./aia_bridge.db
DB_BRIDGE_POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/aia
DB_BRIDGE_MYSQL_DSN=mysql+pymysql://root:password@127.0.0.1:3306/your_game_db
DB_BRIDGE_POLL_LIMIT=500
DB_BRIDGE_WRITE_BATCH_SIZE=200

DEFAULT_RETREAT_HP_THRESHOLD=30
DEFAULT_HEAL_HP_THRESHOLD=50
ADAPTIVE_PREFERRED_BONUS=0.05
ADAPTIVE_AVOID_PENALTY=0.15
LEARNING_REWARD_DECAY=0.98
LEARNING_JOURNAL_ENABLED=true
LEARNING_JOURNAL_PATH=./runtime/learning_journal
LEARNING_JOURNAL_KEEP_LAST=20

# Local game-server integration can keep this disabled only when APP_HOST stays 127.0.0.1.
# For LAN/public deployment, set ENABLE_API_KEY_AUTH=true and configure API_KEY in the Java client.
ENABLE_API_KEY_AUTH=false
API_KEY=
ALLOW_BATCH_REQUESTS=true
MAX_BATCH_SIZE=50
MAX_SCALE_RECOVER_AGENTS=5000
SCHEDULER_CYCLE_BATCH_SIZE=250
TRACE_STORE_ENABLED=true
TRACE_COMPACT_MODE=false
ENABLE_WEBSOCKET_GATEWAY=true
